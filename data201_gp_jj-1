#Opens the filtered dataset
with open('christchurch_filtered.csv', mode='r', newline='', encoding='utf-8') as f:
    reader = csv.reader(f)
    header = next(reader)  #Extracts column headers
    rows = list(reader)    #Loads all rows into memory

#Processes summary statistics for each column
for index, col_name in enumerate(header):
    print(f"\n=== Column: {col_name} ===")

    #Extracts raw string values for the current column
    raw_values = [row[index] for row in rows]

    #Calculates missing/empty values
    missing_count = sum(1 for val in raw_values if val.strip() == '')
    print(f"Missing Values: {missing_count}")

    #Extracts non-empty entries to evaluate data type
    valid_values = [val.strip() for val in raw_values if val.strip() != '']

    #Attempts to isolate valid numbers
    numeric_values = []
    for val in valid_values:
        try:
            numeric_values.append(float(val))
        except ValueError:
            pass #Non-numeric text caught here

    #Checks if this column behaves as a numeric column
    is_numeric = len(numeric_values) == len(valid_values) and len(numeric_values) > 0

    if is_numeric:
        n = len(numeric_values)
        mean_val = sum(numeric_values) / n
        min_val = min(numeric_values)
        max_val = max(numeric_values)

        #Calculates standard deviation
        if n > 1:
            variance = sum((x - mean_val) ** 2 for x in numeric_values) / (n - 1)
            std_val = math.sqrt(variance)
        else:
            std_val = 0.0

        print(f"Min:  {min_val}")
        print(f"Max:  {max_val}")
        print(f"Mean: {mean_val:.2f}")
        print(f"Std:  {std_val:.2f}")
    else:
        #Treats as a categorical column and print counts
        counts = Counter(raw_values)
        print("Category Counts:")
        for category, count in counts.items():
            display_name = "[Missing]" if category.strip() == "" else category
            print(f"  - {display_name}: {count}")
