import csv
import glob
import itertools
import math
from collections import Counter


#Finds all 9 CSV files in the current directory
#Adjusts the path string if your files are in a different folder
csv_files = glob.glob("data/*.csv")

#Opens the combined dataset .csv file
with open("combined_dataset.csv", "w", encoding="utf-8") as outfile:
    #Tracks the header row so it is only written once
    has_header = False

    for file_path in csv_files:
        #Excludes the output file if it happens to match the glob pattern
        if file_path == "combined_dataset.csv":
            continue

        with open(file_path, "r", encoding="utf-8") as infile:
            #Reads the header row of the current file
            header = infile.readline()

            #If this is the very first file, writes the header row
            if not has_header:
                outfile.write(header)
                has_header = True

            #Writes all remaining data rows
            for line in infile:
                outfile.write(line)

print(f"Successfully merged {len(csv_files)} files into combined_dataset.csv")

#Prints headers of combined dataset
with open("combined_dataset.csv", "r", encoding="utf-8") as file:
    header = file.readline().strip()
    print("Column Headers:")
    print(header)

#Filters for Christchurch City
with open('combined_dataset.csv', mode='r', newline='', encoding='utf-8') as f:
    reader = csv.reader(f)
    header = next(reader)  #Saves the column headers

    #Finds the index of the 'neighbourhood_group' column
    group_index = header.index('neighbourhood_group')

    #Filters rows matching "Christchurch City"
    filtered_rows = [row for row in reader if row[group_index] == 'Christchurch City']

#Creates new dataset using filtered data
with open('christchurch_filtered.csv', mode='w', newline='', encoding='utf-8') as f:
    writer = csv.writer(f)
    writer.writerow(header)       #Writes the header first
    writer.writerows(filtered_rows) #Writes the filtered rows

#Prints the first few rows of filtered dataset
