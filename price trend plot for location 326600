import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

#Loads the dataset
df = pd.read_csv('merged_listings_and_bonds.csv')

#Filters for the specific location and handles dates
df_filtered = df[df['location_id'].astype(str) == '326600'].copy()
df_filtered['date'] = pd.to_datetime(df_filtered['date'])

#Groups Year and Month 
df_filtered['year'] = df_filtered['date'].dt.year
df_filtered['month'] = df_filtered['date'].dt.strftime('%b')  # 'Jan', 'Feb', etc.
df_filtered['month_num'] = df_filtered['date'].dt.month

#Calculates the medain price per month and year
trend_df = df_filtered.groupby(['year', 'month', 'month_num'])['price'].median().reset_index()
trend_df = trend_df.sort_values(by=['year', 'month_num'])
trend_df['Year-Month'] = trend_df['year'].astype(str) + '-' + trend_df['month']

#Creates a colourful plot
plt.figure(figsize=(12, 6))
sns.set_theme(style="whitegrid")

#Splist lines dynamically by year
sns.lineplot(
    data=trend_df, 
    x='month', 
    y='price', 
    hue='year', 
    marker='o', 
    palette='rocket',  # Colourful palettes: 'vlag', 'rocket', 'turbo', 'Set2'
    linewidth=2.5
)

#Format chart
plt.title('Price Trends by Month and Year (Location 326600: Christchurch Central)', fontsize=14, pad=15, fontweight='bold')
plt.xlabel('Month', fontsize=12)
plt.ylabel('Median Price ($)', fontsize=12)
plt.legend(title='Year', bbox_to_anchor=(1.05, 1), loc='upper left')

plt.tight_layout()
plt.show()
